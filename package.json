{
  "name": "mytokens",
  "version": "1.3.4",
  "type": "module",
  "bin": {
    "mytokens": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazmusSayad/mytokens.git"
  },
  "scripts": {
    "prepare": "husky",
    "start": "tsx ./src/index.ts",
    "dev": "tsx --watch ./src/index.ts",
    "export": "tsx ./src/index.ts export",
    "export:watch": "tsx --watch ./src/index.ts export",
    "image": "tsx ./src/index.ts image",
    "image:watch": "tsx --watch ./src/index.ts image",
    "build": "tsdown --config ./tsdown.config.ts",
    "build:watch": "tsdown --config ./tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.4",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-oxfmt": "^0.28.0",
    "fuse.js": "^7.5.0",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "1.0.0-rc.13",
    "table": "^6.9.0",
    "terminal-image": "^5.0.1",
    "tsdown": "^0.15.12",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "ulid": "^3.0.2",
    "vitest": "^4.1.10"
  }
}
