{
  "name": "mytokens",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "run ./src/index.ts",
    "start": "rux ./src/index.ts",
    "export": "rux ./src/index.ts export",
    "export:watch": "run ./src/index.ts export",
    "build": "tsdown --config ./tsdown.config.ts",
    "build:watch": "concurrently --names \"R,T\" --prefix-colors \"blue.dim,magenta.dim\" \"tsdown --config ./tsdown.config.ts --watch\" \"tsc --noEmit --watch\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "bin": "dist/index.js",
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fuse.js": "^7.4.2",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown": "1.0.0-rc.13",
    "table": "^6.9.0",
    "tsdown": "^0.15.12",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "ulid": "^3.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "terminal-image": "^5.0.1"
  }
}
