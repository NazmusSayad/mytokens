{
  "name": "mytokens",
  "version": "1.2.7",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "start": "tsx ./src/index.ts",
    "dev": "tsx --watch ./src/index.ts",
    "export": "tsx ./src/index.ts export",
    "export:watch": "tsx --watch ./src/index.ts export",
    "image": "tsx ./src/index.ts image",
    "image:watch": "tsx --watch ./src/index.ts image",
    "build": "tsdown --config ./tsdown.config.ts",
    "build:watch": "tsdown --config ./tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "bin": "dist/index.js",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@inquirer/core": "^11.2.1",
    "@inquirer/prompts": "^8.5.2",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fuse.js": "^7.5.0",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "rolldown": "1.0.0-rc.13",
    "table": "^6.9.0",
    "tsdown": "^0.15.12",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "ulid": "^3.0.2",
    "vitest": "^4.1.10",
    "terminal-image": "^5.0.1"
  }
}
